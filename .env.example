# Copy this file to .env and replace the placeholder values.
# .env is in .gitignore, so your real values never get committed.

# Postgres (used by Docker Compose to create the database)
POSTGRES_USER=muslim_calendar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=muslim_calendar

# How the backend connects to Postgres.
# "db" is the name of the database service in docker-compose.yml.
DATABASE_URL=postgresql://muslim_calendar:change-me@db:5432/muslim_calendar

# Default time zone for prayer times (configurable per user later)
DEFAULT_TIMEZONE=America/Toronto

# Google sign-in. From Google Cloud Console > APIs & Services > Credentials,
# under your OAuth 2.0 Client ID (type: Web application).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must match an "Authorized redirect URI" on that client exactly.
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Key that encrypts Google tokens in the database. Make one with:
#   docker compose run --rm backend python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If you lose or change it, everyone has to sign in again.
TOKEN_ENCRYPTION_KEY=paste-a-generated-fernet-key-here

# Where the app runs. The web service (nginx) serves the website and the
# API together here. POST requests from any other origin are refused.
APP_ORIGIN=http://localhost:8000
# Session cookies are only sent over HTTPS when true. Browsers treat
# http://localhost as secure, so true works locally. Set false only if
# your browser won't keep the cookie.
COOKIE_SECURE=true
SESSION_DAYS=30

# Photon, a free search built on OpenStreetMap data, suggests addresses and
# masjids. It asks apps to give a way to contact the owner.
# Put your own email here. It goes in the User-Agent header of each request.
OSM_CONTACT_EMAIL=you@example.com
# Leave empty to use the public Photon server.
PHOTON_URL=

# OpenRouteService, for drive times to the masjid. Free plan: sign up at
# https://account.heigit.org/signup and copy your API key here.
# Leave it empty to turn drive times off. Prayers still work without it.
ORS_API_KEY=

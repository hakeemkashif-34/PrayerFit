# The server's .env. On the server:
#   cp deploy/production.env.example .env
#   chmod 600 .env        only your user can read it
#   nano .env             replace every placeholder below
# The real .env stays on the server. Never commit it or paste it anywhere.

# ---- The site's address ----
# Every name Caddy gets an HTTPS certificate for, comma separated.
# Now: the free Azure address. After the switch to the domain:
#   SITE_ADDRESS=prayerfit.me, www.prayerfit.me, prayerfit.canadacentral.cloudapp.azure.com
SITE_ADDRESS=prayerfit.canadacentral.cloudapp.azure.com
# The main address. Caddy moves every other name in SITE_ADDRESS here,
# and the backend refuses POSTs from anywhere else.
APP_ORIGIN=https://prayerfit.canadacentral.cloudapp.azure.com

# ---- Postgres ----
# Make a strong password with:  openssl rand -hex 32
# Use the same one in DATABASE_URL. Hex has no characters that break the URL.
POSTGRES_USER=prayerfit
POSTGRES_PASSWORD=paste-the-openssl-output-here
POSTGRES_DB=prayerfit
DATABASE_URL=postgresql://prayerfit:paste-the-openssl-output-here@db:5432/prayerfit

DEFAULT_TIMEZONE=America/Toronto

# ---- Google sign-in ----
# Same OAuth client as the laptop. Add this exact redirect URI to it in
# Google Cloud Console first (README, "Deploy", step 4).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://prayerfit.canadacentral.cloudapp.azure.com/auth/google/callback

# A new key for the server, not the laptop's. Make one with:
#   docker run --rm python:3.13-slim sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
# Keep a copy somewhere safe. If it's lost, everyone has to sign in again.
TOKEN_ENCRYPTION_KEY=paste-a-generated-fernet-key-here

# Cookies only over HTTPS. Always true on the server.
COOKIE_SECURE=true
SESSION_DAYS=30

# ---- Other services ----
# Your email, sent to Photon in the User-Agent header.
OSM_CONTACT_EMAIL=you@example.com
PHOTON_URL=
# OpenRouteService key for drive times. Empty turns drive times off.
ORS_API_KEY=

# Your own Google account email. Only this account can open /stats.
ADMIN_EMAIL=you@example.com
